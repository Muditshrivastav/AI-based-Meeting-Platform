# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/videomeet

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# ─── CORS – comma-separated list of allowed origins ─────────────────────────────
# Local dev example:
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Production example (add your Render/Vercel frontend URL):
CORS_ORIGIN=https://your-frontend.onrender.com,http://localhost:3000

# ─── Frontend URL (used by the AI agent for meeting links) ───────────────────────
FRONTEND_URL=https://your-frontend.onrender.com
CLIENT_URL=https://your-frontend.onrender.com

# ─── AI / Ollama (set USE_OLLAMA=false on Render unless you self-host Ollama) ───
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:31b-cloud

# ─── Google OAuth (if applicable) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
